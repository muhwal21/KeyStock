{
  "name": "keystock-inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace server run dev",
    "dev:web": "npm --workspace client run dev",
    "db:sync": "npm --workspace server run db:sync",
    "db:seed": "npm --workspace server run db:seed",
    "db:fresh": "npm --workspace server run db:fresh",
    "assets:download": "node scripts/download-product-images.mjs",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
