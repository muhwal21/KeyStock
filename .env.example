NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
DOMAIN=your-domain.example
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_SECONDS=28800
ACCESS_COOKIE_NAME=keystock.access
CSRF_COOKIE_NAME=keystock.csrf

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=keystock_inventory
DB_USER=keystock_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Change these before exposing a public deployment.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@keystock.local
SEED_ADMIN_PASSWORD=replace-with-a-unique-password
SEED_PENGUJI_NAME=Penguji
SEED_PENGUJI_USERNAME=penguji
SEED_PENGUJI_EMAIL=
SEED_PENGUJI_PREVIOUS_EMAIL=
SEED_PENGUJI_PASSWORD=

# Optional SMTP settings enable password recovery and review email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SEED_STAFF_NAME=Staff
SEED_STAFF_USERNAME=staff
SEED_STAFF_EMAIL=
SEED_STAFF_PREVIOUS_EMAIL=
SEED_STAFF_PASSWORD=
