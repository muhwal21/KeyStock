NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DOMAIN=your-domain.example
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_SECONDS=28800
ACCESS_COOKIE_NAME=keystock.access
CSRF_COOKIE_NAME=keystock.csrf

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=keystock_inventory
DB_USER=keystock_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Change these before exposing a public deployment.
SEED_ADMIN_NAME=KeyStock Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@keystock.local
SEED_ADMIN_PASSWORD=replace-with-a-unique-password
SEED_DOSEN_NAME=Dosen Penguji
SEED_DOSEN_USERNAME=dosen
SEED_DOSEN_EMAIL=
SEED_DOSEN_PASSWORD=
SEED_STAFF_NAME=Staff Gudang
SEED_STAFF_USERNAME=staff
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
