[Unit]
Description=Create and upload an encrypted KeyStock MySQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/keystock
EnvironmentFile=/etc/keystock/backup.env
ExecStart=/opt/keystock/ops/backup-mysql.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/backups/keystock
